# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/coding_lab_db?schema=public

# Security & JWT
JWT_SECRET=super_secret_jwt_access_key_change_in_production_32chars!
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (In production, specify explicit origins e.g. https://codek.edu.eg,https://app.codek.edu.eg. Wildcards forbidden in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Cookie Configuration (lax for same-site, none for cross-site with HTTPS)
COOKIE_SAMESITE=lax

# Database Connection Pool Configuration
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Video Provider Configuration (MUX, CLOUDFLARE_STREAM, or EXTERNAL in production)
VIDEO_PROVIDER=MUX
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

# Admin defaults
APP_BASE_URL=http://localhost:3000

# =======================================================
# ACADEMY USER CREDENTIALS (FOR DEVELOPMENT & DEMO)
# =======================================================
# For production admin provisioning, run: npm run db:bootstrap:admin
# NEVER use default passwords in production!
ADMIN_LOGIN_ID=ADM-001
ADMIN_EMAIL=admin@codek.edu.eg
ADMIN_PASSWORD=ConfigureAStrongPassword123!
ADMIN_NAME=Academy Administrator

# 2. STUDENT USER (Development demo only)
STUDENT_LOGIN_ID=STU-1001
STUDENT_PASSWORD=Student@123
STUDENT_NAME=Omar Hassan

# 3. PARENT USER (Development demo only)
PARENT_LOGIN_ID=PAR-2001
PARENT_PASSWORD=Parent@123
PARENT_NAME=Hassan Mahmoud

# =======================================================
# SMTP EMAIL SERVICE (OPTIONAL: GMAIL / SENDGRID / BREVO)
# =======================================================
# Leave empty to use local console logger, or fill to send actual emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CodeK Academy" <no-reply@codek.local>

# =======================================================
# PAYMENT PROVIDER (PAYMOB)
# =======================================================
# Get credentials from https://accept.paymob.com dashboard
# Required in production when PAYMENT_PROVIDER=paymob
PAYMENT_PROVIDER=paymob
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_API_BASE=https://accept.paymob.com


