{
  "name": "codek",
  "version": "1.0.0",
  "description": "Backend API for CodeK an Egyptian Programming Academy Platform",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/worker.ts",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:reset-local": "tsx scripts/reset-local-db.ts",
    "db:seed:official-curriculum": "tsx scripts/seed-official-curriculum.ts",
    "seed:curriculum": "tsx prisma/seeds/official-curriculum-eb-part1.ts",
    "seed:curriculum:dry-run": "tsx prisma/seeds/official-curriculum-eb-part1.ts --dry-run",
    "audit:curriculum": "tsx prisma/seeds/official-curriculum-eb-part1.ts --audit",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "fastify",
    "prisma",
    "typescript",
    "postgresql",
    "academy",
    "education"
  ],
  "author": "Antigravity Senior Backend Engineer",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@mux/mux-node": "^15.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.7",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.13.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "ioredis-mock": "^8.13.1",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
