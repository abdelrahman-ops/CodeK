datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STUDENT
  PARENT
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum StudentGrade {
  GRADE_1
  GRADE_2
  GRADE_3
}

enum CurriculumType {
  OFFICIAL_EB
  ACADEMY
}

enum ContentAuthority {
  OFFICIAL
  DERIVED
  PROPOSED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonAccessType {
  ATTENDANCE_REQUIRED
  FREE
  ENROLLED
  SUBSCRIPTION_REQUIRED
  ADMIN_GRANTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  REJECTED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum AccessGrantScope {
  ALL_ACCESS
  COURSE
  LESSON
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoAssetStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  ERROR
}

enum TaskType {
  DAILY_TASK
  CHALLENGE
  PROJECT
  WEEKLY_CHALLENGE
}

enum SubmissionStatus {
  PENDING
  REVIEWED
  APPROVED
  NEEDS_REVISION
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum XPSourceType {
  ATTENDANCE
  TASK
  CHALLENGE
  PROJECT
  EXAM
  QUIZ
  LESSON
  ACHIEVEMENT
  MANUAL
}

enum LeaderboardStatus {
  ACTIVE
  FINALIZED
}

enum AuthTokenType {
  PARENT_INVITE
  PASSWORD_RESET
  ADMIN_LOGIN_OTP
  EMAIL_VERIFICATION
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum NotificationType {
  INFO
  LESSON_UNLOCKED
  TASK_ASSIGNED
  TASK_REVIEWED
  ACHIEVEMENT_UNLOCKED
  EXAM_AVAILABLE
  EXAM_RESULT
  LEADERBOARD_FINALIZED
  PAYMENT_REMINDER
}

enum RegistrationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  EXPIRED
  ARCHIVED
}

model User {
  id                 String          @id @default(uuid())
  loginId            String          @unique // e.g. "ADM-001", "STU-1001", "PAR-2001"
  email              String?         @unique
  phone              String?
  passwordHash       String
  mustChangePassword Boolean         @default(true) // Enforces first-login credential update
  isEmailVerified    Boolean         @default(false) // Email verification gate for new registrations
  role               Role            @default(STUDENT)
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  student            Student?
  parent             Parent?
  authTokens         AuthToken[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("ActorAuditLogs")
  reviewedRegistrations StudentRegistration[] @relation("ReviewedRegistrations")
  grantedAccessGrants   EducationalAccessGrant[] @relation("GrantedAccessGrants")

  @@index([role, isActive])
  @@index([phone])
}

model Student {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode              String                 @unique // Human-readable e.g. "STU-1001"
  anonymousLeaderboardCode String?                // Anonymized code for competition privacy
  programmingLevel         Difficulty             @default(BEGINNER)
  attendanceRequired       Boolean                @default(false)
  learningModeSelected     Boolean                @default(false) // true after onboarding mode selection
  schoolName       String?
  grade            StudentGrade?
  dateOfBirth      DateTime?
  totalXp          Int                    @default(0)
  currentStreak    Int                    @default(0)
  lastActiveDate   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  enrollments      GroupEnrollment[]
  attendances      Attendance[]
  submissions      Submission[]
  examAttempts     ExamAttempt[]
  xpTransactions   XPTransaction[]
  achievements     StudentAchievement[]
  leaderboardRows  MonthlyLeaderboardEntry[]
  parents          ParentStudent[]
  payments         Payment[]
  registration     StudentRegistration?
  lessonProgress   StudentLessonProgress[]
  subscriptions    Subscription[]
  paymentTransactions PaymentTransaction[]
  accessGrants     EducationalAccessGrant[]

  @@index([totalXp])
}

model Parent {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCode       String          @unique // Human-readable e.g. "PAR-2001"
  preferredChannel String          @default("WHATSAPP") // "WHATSAPP", "SMS", "EMAIL"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  children         ParentStudent[]
}

model ParentStudent {
  id           String           @id @default(uuid())
  parentId     String
  parent       Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship RelationshipType @default(GUARDIAN)
  isPrimary    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@unique([parentId, studentId])
  @@index([studentId])
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  INVALIDATED
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique // Hashed token (SHA-256)
  type      AuthTokenType
  status    OtpStatus     @default(PENDING)
  attempts  Int           @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([userId, type, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // Hashed refresh token (SHA-256)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Group {
  id               String            @id @default(uuid())
  name             String            @unique // e.g. "Group A"
  description      String?
  scheduleInfo     String?           // e.g. "Saturday 5:00 PM"
  whatsappGroupUrl String?           // e.g. "https://chat.whatsapp.com/..."
  maxCapacity      Int               @default(20)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  enrollments     GroupEnrollment[]
  sessions        Session[]
  schedules       GroupSchedule[]
  taskAssignments TaskAssignment[]
  exams           Exam[]
  preferredRegistrations StudentRegistration[] @relation("PreferredGroupRegistrations")
}

model GroupSchedule {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday, 4 = Thursday, 5 = Friday, 6 = Saturday
  startTime String   // e.g. "16:00"
  endTime   String   // e.g. "17:30"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, dayOfWeek])
  @@index([groupId, isActive])
  @@index([dayOfWeek, isActive])
}

model GroupEnrollment {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)

  @@index([studentId, isActive])
  @@index([groupId, isActive])
  @@unique([studentId, groupId, startedAt])
}

model Session {
  id             String          @id @default(uuid())
  groupId        String
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessionNumber  Int
  date           DateTime
  startTime      String          // "17:00"
  endTime        String          // "18:30"
  status         SessionStatus   @default(SCHEDULED)
  tokenHash      String?         @unique // SHA-256 hash of QR token
  tokenExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  attendances    Attendance[]
  sessionLessons SessionLesson[]

  @@unique([groupId, sessionNumber])
  @@index([groupId, date, status])
}

model Attendance {
  id                 String           @id @default(uuid())
  sessionId          String
  session            Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             AttendanceStatus @default(PRESENT)
  isManual           Boolean          @default(false)
  studentConfirmedAt DateTime?
  adminConfirmedAt   DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([sessionId, status])
}

model Curriculum {
  id           String           @id @default(uuid())
  code         String?          @unique
  title        String
  description  String?
  type         CurriculumType   @default(OFFICIAL_EB)
  track        String?          // "Fundamentals", "Python", "AI", "Web"
  grade        StudentGrade
  academicYear String?          // e.g. "2026/2027"
  term         String?          // e.g. "TERM_1"
  authority    ContentAuthority @default(OFFICIAL)
  isPublished  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lessons      Lesson[]
  sections     Section[]
  exams        Exam[]
  accessGrants EducationalAccessGrant[]

  @@index([grade])
}

model Lesson {
  id                       String           @id @default(uuid())
  curriculumId             String
  curriculum               Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  code                     String?
  title                    String
  description              String?
  pageRange                String?          // e.g. "4-11"
  content                  String           // Full markdown
  conceptCards             Json?            // Structured concept cards JSON
  authority                ContentAuthority @default(OFFICIAL)
  difficulty               Difficulty       @default(BEGINNER)
  estimatedDurationMinutes Int              @default(45)
  order                    Int              @default(1)
  isPublished              Boolean          @default(true)
  externalResourceUrl      String?
  externalResourceTitle    String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  sessionLessons           SessionLesson[]
  tasks                    Task[]
  sectionId                String?
  section                  Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  isFree                   Boolean                @default(false)
  accessType               LessonAccessType       @default(SUBSCRIPTION_REQUIRED)
  videoUrl                 String?
  videoDurationSeconds     Int?
  videoId                  String?
  video                    VideoAsset?            @relation(fields: [videoId], references: [id], onDelete: SetNull)
  progress                 StudentLessonProgress[]
  exams                    Exam[]
  accessGrants             EducationalAccessGrant[]

  @@unique([curriculumId, code])
  @@index([sectionId])
  @@index([videoId])
}

model Section {
  id           String           @id @default(uuid())
  curriculumId String
  curriculum   Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  code         String?
  title        String
  description  String?
  order        Int              @default(1)
  authority    ContentAuthority @default(OFFICIAL)
  isPublished  Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lessons      Lesson[]

  @@unique([curriculumId, code])
  @@index([curriculumId, order])
}

model VideoAsset {
  id              String           @id @default(uuid())
  code            String?          @unique
  provider        String           // "MUX", "CLOUDFLARE_STREAM", "MOCK", "EXTERNAL"
  providerVideoId String           // provider's internal video id or playback id (e.g. Mux asset ID)
  uploadId        String?          @unique // Mux direct upload ID
  playbackId      String?          // Mux signed playback ID
  title           String?
  durationSeconds Int?
  thumbnailUrl    String?
  playbackUrl     String?
  isPrivate       Boolean          @default(true)
  status          VideoAssetStatus @default(READY)
  errorMessage    String?
  metadata        Json?
  authority       ContentAuthority @default(PROPOSED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lessons         Lesson[]

  @@index([provider, providerVideoId])
  @@index([uploadId])
  @@index([status])
}

model StudentLessonProgress {
  id                  String               @id @default(uuid())
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status              LessonProgressStatus @default(NOT_STARTED)
  progressPercentage  Int                  @default(0)
  lastWatchedPosition Int                  @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, status])
  @@index([lessonId])
}

model SessionLesson {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int      @default(1)

  @@unique([sessionId, lessonId])
}

model Task {
  id                       String           @id @default(uuid())
  lessonId                 String?
  lesson                   Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  code                     String?
  title                    String
  description              String
  instructions             String
  taskType                 TaskType         @default(DAILY_TASK)
  difficulty               Difficulty       @default(BEGINNER)
  estimatedDurationMinutes Int              @default(45)
  xpReward                 Int              @default(30)
  authority                ContentAuthority @default(PROPOSED)
  isPublished              Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  assignments              TaskAssignment[]
  submissions              Submission[]

  @@unique([lessonId, code])
}

model TaskAssignment {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  availableAt DateTime  @default(now())
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  @@unique([taskId, groupId])
}

model Submission {
  id          String           @id @default(uuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     String?          // Text answer / solution
  fileUrl     String?
  githubUrl   String?
  status      SubmissionStatus @default(PENDING)
  feedback    String?
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  @@unique([taskId, studentId])
  @@index([studentId, status])
}

model Exam {
  id              String           @id @default(uuid())
  title           String
  description     String?
  curriculumId    String?
  curriculum      Curriculum?      @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  groupId         String?
  group           Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  code            String?
  isQuiz          Boolean          @default(false)
  startsAt        DateTime
  endsAt          DateTime
  durationMinutes Int              @default(45)
  totalMarks      Int              @default(100)
  xpReward        Int              @default(100)
  authority       ContentAuthority @default(PROPOSED)
  isPublished     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions       ExamQuestion[]
  attempts        ExamAttempt[]

  @@unique([lessonId, code])
  @@index([lessonId])
}

model ExamQuestion {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  options       String?      // JSON array of options for multiple choice
  correctAnswer String?      // Target answer / key
  marks         Int          @default(5)
  order         Int          @default(1)

  @@index([examId, order])
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     String   // JSON string of answers
  score       Int      @default(0)
  percentage  Float    @default(0.0)
  xpEarned    Int      @default(0)
  submittedAt DateTime @default(now())

  @@unique([examId, studentId])
}

model XPTransaction {
  id         String       @id @default(uuid())
  studentId  String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  sourceType XPSourceType
  sourceId   String?      // e.g. taskId, sessionId, examAttemptId, achievementId
  createdAt  DateTime     @default(now())

  @@unique([studentId, sourceType, sourceId])
  @@index([studentId, createdAt])
}

model Achievement {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String
  icon        String               // Emoji or icon key
  xpReward    Int                  @default(50)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  students    StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(uuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([studentId, achievementId])
}

model MonthlyLeaderboard {
  id         String                    @id @default(uuid())
  year       Int
  month      Int                       // 1 - 12
  status     LeaderboardStatus         @default(ACTIVE)
  revealDate DateTime?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  entries    MonthlyLeaderboardEntry[]

  @@unique([year, month])
}

model MonthlyLeaderboardEntry {
  id            String             @id @default(uuid())
  leaderboardId String
  leaderboard   MonthlyLeaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank          Int
  monthlyXp     Int
  anonymousCode String
  createdAt     DateTime           @default(now())

  @@unique([leaderboardId, studentId])
  @@index([leaderboardId, rank])
}

model Payment {
  id        String        @id @default(uuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year      Int
  month     Int           // 1 - 12
  amount    Int           // EGP amount (e.g. 250)
  status    PaymentStatus @default(UNPAID)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([studentId, year, month])
  @@index([year, month, status])
  @@index([studentId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // e.g. "LOGIN", "ATTENDANCE_MARKED", "PAYMENT_MARKED_PAID"
  entityType  String   // e.g. "User", "Session", "Task", "Payment", "Exam"
  entityId    String?
  metadata    String?  // JSON string containing non-sensitive details
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model StudentRegistration {
  id                 String             @id @default(uuid())
  registrationCode   String             @unique // Human-readable e.g. "REG-7K42M"

  firstName          String
  lastName           String
  phone              String             // Normalized phone e.g. "+201012345678"
  whatsappPhone      String?
  email              String?

  dateOfBirth        DateTime?
  schoolName         String?
  grade              StudentGrade?
  programmingLevel   Difficulty         @default(BEGINNER)
  previousExperience String?
  motivation         String?

  preferredDays      String?
  preferredTimes     String?
  preferredGroupId   String?
  preferredGroup     Group?             @relation("PreferredGroupRegistrations", fields: [preferredGroupId], references: [id], onDelete: SetNull)

  parentName         String?
  parentPhone        String?
  parentRelationship RelationshipType?

  status             RegistrationStatus @default(PENDING)

  adminNotes         String?
  rejectionReason    String?

  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewedByUser     User?              @relation("ReviewedRegistrations", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdStudentId   String?            @unique
  createdStudent     Student?           @relation(fields: [createdStudentId], references: [id], onDelete: SetNull)

  clientIp           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model RegistrationSetting {
  id               String    @id @default("default")
  isOpen           Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  maxRegistrations Int?
  updatedAt        DateTime  @updatedAt
}

model PaymentSetting {
  id                       String    @id @default("default")
  vodafoneCashNumber       String    @default("01012345678")
  vodafoneCashInstructions String?   @default("حول المبلغ المطلوب إلى رقم فودافون كاش ثم أدخل رقم الهاتف المحول منه ورقم العملية لتأكيد الدفع.")
  instaPayAddress          String    @default("codek@instapay")
  instaPayInstructions     String?   @default("حول المبلغ المطلوب عبر تطبيق إنستاباي إلى العنوان أعلاه ثم أدخل الرقم المرجعي للتحويل.")
  vodafoneCashEnabled      Boolean   @default(true)
  instaPayEnabled          Boolean   @default(true)
  paymobEnabled            Boolean   @default(true)
  updatedAt                DateTime  @updatedAt
}

model SubscriptionPlan {
  id              String         @id @default(uuid())
  name            String
  code            String         @unique // e.g. "FULL_ACADEMY_MONTHLY"
  description     String?
  price           Int            // in EGP
  currency        String         @default("EGP")
  billingInterval String         @default("MONTHLY") // "MONTHLY", "QUARTERLY", "YEARLY"
  isActive        Boolean        @default(true)
  features        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
}

model Subscription {
  id                 String             @id @default(uuid())
  studentId          String
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  transactions       PaymentTransaction[]

  @@index([studentId, status])
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  subscriptionId        String?
  subscription          Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  studentId             String
  student               Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId                String?
  plan                  SubscriptionPlan?        @relation(fields: [planId], references: [id])
  provider              String?                  // e.g. "MANUAL", "PAYMOB", "FAWRY"
  providerTransactionId String?
  providerIntentionId   String?                  // Paymob intention_id or equivalent
  amount                Int                      // In EGP (whole units)
  currency              String                   @default("EGP")
  status                PaymentTransactionStatus @default(PENDING)
  description           String?
  paidAt                DateTime?
  refundedAt            DateTime?
  expiresAt             DateTime?                // For kiosk/reference code payment expiry
  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([studentId, status])
  @@index([provider, providerTransactionId])
  @@index([providerIntentionId])
}

model PaymentWebhookEvent {
  id           String    @id @default(uuid())
  provider     String    // "PAYMOB", "FAWRY", "STRIPE"
  eventId      String?
  eventType    String
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSED, FAILED
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([provider, eventId])
}

model EducationalAccessGrant {
  id              String           @id @default(uuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scope           AccessGrantScope @default(ALL_ACCESS)
  curriculumId    String?
  curriculum      Curriculum?      @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lessonId        String?
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  grantedByUserId String?
  grantedByUser   User?            @relation("GrantedAccessGrants", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  reason          String           // "Scholarship", "Testing", "Exceptional exemption", etc.
  validFrom       DateTime         @default(now())
  validUntil      DateTime?        // null = indefinite, or future expiration date
  isActive        Boolean          @default(true)
  revokedAt       DateTime?
  revokedByUserId String?
  revokedReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([studentId, isActive])
  @@index([curriculumId])
  @@index([lessonId])
}

